#!/bin/bash

#SBATCH --job-name=raxml-ng
#SBATCH --partition=long
#SBATCH --array=0-610%20
#SBATCH --cpus-per-task=20
#SBATCH --mem=800MB
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
# T0.raxml.reduced.phy is the reduced matrix generated by RaxML after removing undeterminate sites and duplicate sequences/samples.
# By default raxml will perform 20 tree searches using 10 random and 10 parsimony-based starting trees, and pick the best-scoring topology.
# The option --tree pars{20},rand{20} sets 40 starting trees to explore the tree space. This means, to perform 40 independent searches resulting in 40 trees for each locus.
# The option --rfdist compute the topological Robinson-Foulds (RF) distance among all resulting trees. It's possible to use this metrics as a measure of topological uncertainty by
# examining the .rfDistances file.
# By default, RAxML-NG employs so-called MRE-based bootstopping test to automatically determine the sufficient number of BS replicates. The diagnostic statistics is evaluated after
# every 50 BS tree inferences, and once its value drops below the cutoff (average weighted RF of 3% or 0.03), the analysis stops.
# The option --bs-metric maps bootstrap values onto the best-scoring/best-known ML tree.
# Option --all runs both ML search and bootstrap analysis.
# In RAxML-NG, thread pinning is enabled by default only in the hybrid MPI/pthreads mode when 1 MPI rank per node is used. But, the option --extra thread-nopin disables thread pinning,
# avoiding the error: error calling pthread_setaffinity_np 22
# These analyses used between 600 MB and 2.5G and 20 threads each, and ran for about 2h each.

###########
# COMMANDS
###########

## Define names
mtype=exons
program=raxml
method=trimal

## Input fasta files
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/all_$mtype/trimmed_alignm

## Output path
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/all_$mtype/$program/tsearch30
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/all_$mtype/$program/tsearch30

## Go to the alignments folder
cd $fpath

## Define variable to list all alignment and iterate over each element using the SLURM_ARRAY_TASK_ID variable
gene_list=($(ls $fpath | grep $method))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})

## Get info about best-fit substitution model previously obtained using Iqtree
bmpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/all_$mtype/iqtree_plus_models/best_fit_models_summ.txt
model=$(cat $bmpath | grep $gene | cut -d ':' -f 3)

## Tree inference
~/scratch/apps/addprograms/raxml-ng/build/bin/raxml-ng-mpi --threads auto{20} \
                                                           --extra thread-nopin \
                                                           --all \
                                                           --msa $gene \
                                                           --model $model \
                                                           --seed 2442 \
                                                           --tree pars{30},rand{30} \
                                                           --bs-metric tbe \
                                                           --prefix $rpath/$gene

echo Tree search using RaxML-NG finished for gene $gene
