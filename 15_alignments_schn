#!/bin/bash

#SBATCH --job-name=mafft
#SBATCH --partition=medium
#SBATCH --array=0-273%10
#SBATCH --cpus-per-task=4
#SBATCH --mem=500MB
#SBATCH --mail-user=xxx@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## Align DNA sequences for each locus using the algorith E-INS-i inplemented in mafft. This algorithm is suitable to align multiple cDNAs
## and multiple genomic sequences of a gene from closely related species, which has several conserved motifs embedded in long unalignable regions.
## As E-INS-i has the minimum assumption of the three methods, this is recommended if the nature of sequences to be aligned is not clear.
## Most genes run well with 500MB. However, genes with a lot of sites are difficult to  align.
## Consequentlyl, they need more memory. Three additional runs were required, 4G, 12G and 60G (for g2009517).
## For supercontig, 12G were not enought for 21 loci. Finally they required 20G.

###########
# COMMANDS
###########

## Activate conda environment (because mafft was installed as part of hybpiper)
source activate hybpiper

## Define names
probe=schn
imtype=rmout_infprlgs
addf=rmprlgs

## Define fasta file path
fpath=~/projects/hybpiper/fasta_files/$probe/exons/$imtype/$addf

## Output path
mkdir -p ~/projects/alignments/$imtype
rpath=~/projects/alignments/$imtype

## Go to input-files folder
cd $fpath

## Define variable to list fasta files and iterate over each element using the SLURM_ARRAY_TASK_ID variable
## Path to a list of selected genes
gene_list=($(ls * | grep FNA$))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})
gnm=$(echo $gene | sed 's/\.FNA//')

## Run mafft
mafft --thread ${SLURM_CPUS_PER_TASK} --genafpair --adjustdirectionaccurately --maxiterate 1000 $gene > $rpath/"$gnm"_align.fas

echo MAFFT finished for gene $gene
