#!/bin/bash

#SBATCH --job-name=rooting
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=3MB
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## Run pxrr function of phyx package to root species tree from Astral

###########
# COMMANDS
###########

## Define names
mtype=supercontig

## Input trees
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/$mtype/wastral

## Root sp tree using two outgroups (Bonn_stricta_Benko-Iseppon1726 = SRR10951426 and Hype_perforatum_OneKP132735 = ERR2040370)
cd $fpath
for i in *.tre
do
 echo $i
 /home/sreinale/scratch/apps/conda/bin/pxrr -t $i -g Bonn_stricta_Benko-Iseppon1726,Hype_perforatum_OneKP132735 > rooted_$i
done

echo "Rooting done!"
