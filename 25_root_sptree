#!/bin/bash

#SBATCH --job-name=rooting
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=3MB
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## Run pxrr function of phyx package to root species tree from Astral
## For rooting all trees at the same time, create a file with all folder names where
## astral trees were saved and iterate on it.

###########
# COMMANDS
###########

## Rooting all trees produced by wAstral and astral-pro at the same time
## Save folder names in as environmental variable
TREES=$(cat /home/sreinale/scripts/sauvagesieae_phylogeny/folder_list)

## Iterate folders
for h in $TREES; do

 ## Input trees
 fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/$h/*astral*

 ## Root each species tree using two outgroups (Bonn_stricta_Benko-Iseppon1726 = SRR10951426 and Hype_perforatum_OneKP132735 = ERR2040370)
 ## in case of more than one tree in the folder, iterate on it
 cd $fpath
 for i in *.tre; do
  /home/sreinale/scratch/apps/conda/bin/pxrr -t $i -g Bonn_stricta_Benko-Iseppon1726,Hype_perforatum_OneKP132735 > rooted_$i
 echo Tree $i in folder $h rooted!
 done
done

echo "Rooting done!"

