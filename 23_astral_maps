#!/bin/bash

#SBATCH --job-name=prlgs-map
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=100MB
#SBATCH --mail-user=xxx@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## Run R script to extract sequence IDs from each gene-tree and write a map file for ASTRAL

###########
# COMMANDS
###########

## Create an output folder
mkdir -p ~/projects/trees/paralogs_map

## Activate conda environment
source activate renv

## Run r script
Rscript --vanilla multiseq_map.R

## Merge all maps in a single file
cd ~/projects/trees/paralogs_map

cat *.map | sort | uniq > multiseqID_all.map

echo paralogs_map created!
