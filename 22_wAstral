#!/bin/bash

#SBATCH --job-name=wastral
#SBATCH --partition=medium
#SBATCH --cpus-per-task=16
#SBATCH --mem=8G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## Options -r ans -s run with more rounds of placement for ensured optimality (default is 4 and 4)
## To place taxa on an existing fully resolved species tree, use -c SPECIES_TREE_IN_NEWICK_FORMAT
## Option -u 0 to compute species tree topology only. Option -u 2 to add support and local-PP for all three resolutions of each branch

###########
# COMMANDS
###########

## Input trees
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/BS10_MLtrees

## Output path
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/astral-pro
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/astral-pro/re-run

## Merge all gene trees in a single file
cd $fpath
cat *BS10.tre > $rpath/sauv_prlgs_all_BS10_gtrees.tre

## Path to multi-sequence IDs map
msID_map=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/paralog_maps/multiseqID_all.map

## Go to output path
cd $rpath

## Run Astral-pro withouth annotations
~/scratch/apps/addprograms/ASTER/bin/astral-pro -t ${SLURM_CPUS_PER_TASK} \
                                                -r 16 -s 16 \
                                                -u 0 \
                                                -a $msID_map \
                                                -o sauv_prlgs_all_BS10_sptree.tre \
                                                -i sauv_prlgs_all_BS10_gtrees.tre 2>sauv_prlgs_all_BS10_sptree.log

## Run Astral-pro with annotations
~/scratch/apps/addprograms/ASTER/bin/astral-pro -t ${SLURM_CPUS_PER_TASK} \
                                                -r 16 -s 16 \
                                                -u 2 \
                                                -a $msID_map \
                                                -o sauv_prlgs_all_BS10_sptree_annot.tre \
                                                -i sauv_prlgs_all_BS10_gtrees.tre 2>sauv_prlgs_all_BS10_sptree_annot.log


echo Astral-pro finished!
