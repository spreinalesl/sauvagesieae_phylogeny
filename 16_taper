#!/bin/bash

#SBATCH --job-name=taper
#SBATCH --partition=medium
#SBATCH --array=0-613%50
#SBATCH --cpus-per-task=1
#SBATCH --mem=500G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## TAPER looks for errors in small species-specific stretches of the multiple sequence alignments. This command will detect erronous sequences and will replace them with N
## in the output, and all N characters are treated as a dash. A cutoff (make sense to > 1) to control aggressiveness of error detection. The lower the cutoff is,
## the more aggressive the TAPER becomes. Values below 1 are allowed but discouraged. The default cutoff is -c 3. For example, if you want TAPER be more precautious,
## you can try -c 10.
## Most samples run with 500M, just 4 (4527, g2009517, g2011628, g2026803) need 1G

###########
# COMMANDS
###########

## Activate conda environment
source /home/sreinale/.bashrc
source activate julia

## Define names
mtype=rm_out_exons

## Input fasta files
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/$mtype

## Output path
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/$mtype/trimmed_alignm
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/$mtype/trimmed_alignm

## Go to the alignments folder
cd $fpath

## Define variable to list all alignment and iterate over each element using the SLURM_ARRAY_TASK_ID variable
## Path to a list of selected genes (all schn plus a353 genes with more than 25% of taxa represented)
gene_list=($(ls * | grep fas$))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})

## Run TAPER
julia ~/scratch/apps/addprograms/taper/correction_multi.jl -m N -a N -c 10 $gene > $rpath/taper_$gene

echo TAPER finished for gene $gene
