#!/bin/bash

#SBATCH --job-name=ochn_multiqc
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --mail-user=xxx@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
# The environment that we are working inside includes a version of the Firefox web browser. We can open a particular HTML file with firefox using the command:
# firefox results/SRR1552444_fastqc.html
# This analysis took 1.43min in a single core using 0.42G memmory for 192 reports

###########
# COMMANDS
###########
ipath=~/projects

mkdir -p $ipath/multiqc

multiqc $ipath/fastqc/*fastqc.zip -o $ipath/multiqc > $ipath/multiqc/multiqc.outerr 2>&1
