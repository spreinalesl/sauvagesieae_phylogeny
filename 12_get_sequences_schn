#!/bin/bash

#SBATCH --job-name=seqs
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=1G
#SBATCH --mail-user=xxx@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## This command fetches the sequences recovered for the same gene from multiple samples and generates
## an unaligned multi-FASTA file for each gene saved in fasta_files

###########
# COMMANDS
###########

## Activate conda environment
source ~/.bashrc
source activate hybpiper

## Temporary folder
cd $TMPDIR

## As all sample runs have to be in the same directory, copy runs of the same probe set in a temporary folder
pname=schn
dpath=~/projects/hybpiper

cp -r $dpath/addseqs_$pname/SRR* ./
cp -r $dpath/sauv_sprl/$pname/SPRL* ./
cp -r $dpath/transcripts/$pname/ERR* ./

echo Copy Done!

## Create a folder to save fasta files for each gen
mkdir -p $pname
mkdir -p $pname/exons
mkdir -p $pname/introns
mkdir -p $pname/supercontig

## Output path
rpath=./$pname

## Define namelist file
namelist=~/projects/namelist_all_schn.txt

## Define target file
tfile=~/projects/new_targets/OCHNA-input-seq_Targets_DNA_BaitKit_edit_crop.fas

## Generate an unaligned multi-FASTA file for each gene (only exons)
hybpiper retrieve_sequences dna -t_dna $tfile --sample_names $namelist --fasta_dir $rpath/exons

## Generate an unaligned multi-FASTA file for each gene (only introns)
hybpiper retrieve_sequences intron -t_dna $tfile --sample_names $namelist --fasta_dir $rpath/introns

## Generate an unaligned multi-FASTA file for each gene (only introns)
hybpiper retrieve_sequences supercontig -t_dna $tfile --sample_names $namelist --fasta_dir $rpath/supercontig

## Move results from temporary folder to scratch
mkdir -p ~/projects/hybpiper/fasta_files
mv $pname ~/projects/hybpiper/fasta_files

echo Done!
