#!/bin/bash

#SBATCH --job-name=raxml-ng
#SBATCH --partition=short
#SBATCH --array=0-271%100
#SBATCH --cpus-per-task=20
#SBATCH --mem=4G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
# T0.raxml.reduced.phy is the reduced matrix generated by RaxML after removing undeterminate sites and duplicate sequences/samples.
# The option --tree pars{10},rand{10} sets 20 starting trees to explore the tree space. This means, to perform 20 independent searches resulting in 20 trees for each locus.
# The option --rfdist compute the topological Robinson-Foulds (RF) distance among all resulting trees. It's possible to use this metrics as a measure of topological uncertainty by
# examining the .rfDistances file.
# By default, RAxML-NG employs so-called MRE-based bootstopping test to automatically determine the sufficient number of BS replicates. The diagnostic statistics is evaluated after
# every 50 BS tree inferences, and once its value drops below the cutoff (average weighted RF of 3% or 0.03), the analysis stops.
# The option --bs-metric maps bootstrap values onto the best-scoring/best-known ML tree.
# In RAxML-NG, thread pinning is enabled by default only in the hybrid MPI/pthreads mode when 1 MPI rank per node is used. But, the option --extra thread-nopin disables thread pinning,
# avoiding the error: error calling pthread_setaffinity_np 22
# These analyses used in mean 2.5G and 20 threads each, and ran for about 2h each.

###########
# COMMANDS
###########

## Input fasta files
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/taper/schn

## Output path
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/raxml/schn
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/raxml/schn

## Go to the alignments folder
cd $fpath

## Define variable to list all alignment and iterate over each element using the SLURM_ARRAY_TASK_ID variable
## Path to a list of selected genes (all schn plus a353 genes with more than 25% of taxa represented)
glistpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/hybpiper/get_seqs_summ/selected_genes.txt
gene_list=($(cat $glistpath))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})

## Get info about best-fit substitution model previously obtained using Iqtree
bmpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/subs_model/best_fit_models_summ.txt
model=$(cat $bmpath | grep $gene | cut -d ':' -f 3)

## Tree inference
~/scratch/apps/addprograms/raxml-ng/build/bin/raxml-ng-mpi --threads ${SLURM_CPUS_PER_TASK} \
                                                           --extra thread-nopin \
                                                           --all \
                                                           --msa $gene*.fasta \
                                                           --model $model \
                                                           --seed 2442 \
                                                           --tree pars{10},rand{10} \
                                                           --bs-metric tbe \
                                                           --prefix $rpath/$gene


echo Tree searches using RaxML-NG finished for gene $gene
