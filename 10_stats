#!/bin/bash

#SBATCH --job-name=stats
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=20G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## gene option generates stats only for exons. To get info about exons+introns use supercontig
## Heatmap is highly memory consuming

###########
# COMMANDS
###########

## Activate conda environment
source /home/sreinale/.bashrc
source activate hybpiper

## Define paths
rpath=~/scratch/private/sauvagesieae/hybpiper/transcripts/schn

# namelist
npath=~/scratch/private/sauvagesieae/namelist_trans.txt

## Define target file
tfile=~/scratch/private/sauvagesieae/hybpiper/new_targets/OCHNA-input-seq_Targets_DNA_BaitKit_edit_crop.fas

## Summarize target enrichment and gene recovery efficiency for all samples (All DNA sequences)
cd $rpath

hybpiper stats -t_dna $tfile gene $npath

## Create a heatmap to assess the overall success of HybPiper in recovering coding sequences
hybpiper recovery_heatmap seq_lengths.tsv
