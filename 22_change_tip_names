#!/bin/bash

#SBATCH --job-name=idTOspp
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=500MB
#SBATCH --mail-user=xxx@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## This script merges individual trees in a single file and changes tip names from sample ID to species name
## alternative, it is possible to process individual trees, just dont run the merge commands.
## Min mem req 200MB
## For all_exons 500MB

###########
# COMMANDS
###########

## Matrix path name
mtype=smp30_prlgbothgns_outliers_rm_exons
program=iqtree
addf=

## Input trees
fpath=~/projects/trees/$mtype/$program/$addf

## Output path
output=names_ed
mkdir -p $fpath/$output
rpath=$fpath/$output

## Go to tree folder
cd $fpath

## Merge all gene trees in a single file
cat *.treefile > sauv_"$mtype"_gtrees.tre
echo trees were merged!

## Fix a %$#$@#% problem caused by the MAFFT function --adjustdirectionaccurately
sed -i -e 's/_R_SPRL_145/SPRL_145/g' sauv_"$mtype"_gtrees.tre
echo MAFFT problem fixed!

## Activate conda environment to run R
source activate renv

## Change sample IDs for species names
## Run r script
Rscript --vanilla ~/scripts/change_tip_names.R

echo "sample IDs to species names done!"
