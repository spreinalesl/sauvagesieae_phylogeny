#!/bin/bash

#SBATCH --job-name=taper
#SBATCH --partition=short
#SBATCH --array=0
#SBATCH --cpus-per-task=1
#SBATCH --mem=1200MB
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## TAPER looks for errors in small species-specific stretches of the multiple sequence alignments. This command will detect erronous sequences and will replace them with N
## in the output, and all N characters are treated as a dash. A cutoff (make sense to > 1) to control aggressiveness of error detection. The lower the cutoff is,
## the more aggressive the TAPER becomes. Values below 1 are allowed but discouraged. The default cutoff is -c 3. For example, if you want TAPER be more precautious,
## you can try -c 10.
## Most samples run with 250MB, just 4 (4527, g2009517, g2011628, g2026803) need 1G
## For supercontig 1G was required

###########
# COMMANDS
###########

## Input fasta files
fpath=~/scratch/private/phylonetworks/alignments

## Output path
mkdir -p $fpath/trimmed_alignm
rpath=$fpath/trimmed_alignm

## Go to the alignments folder
cd $fpath

## Define variable to list all alignment and iterate over each element using the SLURM_ARRAY_TASK_ID variable
gene_list=($(ls * | grep fas$))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})

## Run TAPER
/home/sreinale/apps/julia/bin/./julia ~/apps/taper/correction_multi.jl -m - -a N -c 5 $gene > $rpath/$gene

echo TAPER finished for gene $gene
