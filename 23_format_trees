 ## Run pxrr to root trees using two outgroups (Bonnetia_stricta_Benko-Iseppon1726 = SRR10951426 and Hypericum_perforatum_OneKP132735 = ERR2040370)
 # -g ERR2040370,SRR10951426
 # ERR5034069 (Campylospermum_reticulatum_Cable3433), SRR14767573 (Campylospermum_reticulatum_Cable3433)
 # ERR5034076	Ochna_membranacea_Konomou261
 # SRR14767553	Ochna_membranacea_Konomou261
 # ERR2040388	Ochna_serrulata_OneKPJLM2013-53

 echo $i

 ~/scratch/apps/conda/bin/pxrr -t sauv_ortlgs_"$i"_BS10_sptree_annot.tre -g ERR5034076 > sauv_ortlgs_"$i"_BS10_sptree_annot_rooted.tre

 ~/scratch/apps/conda/bin/pxrr -t sauv_ortlgs_"$i"_BS10_sptree.tre -g ERR5034076 > sauv_ortlgs_"$i"_BS10_sptree_rooted.tre
