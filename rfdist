## Estimate RF distances among resulting unrooted trees
cd $fpath
for i in *.tre; do
 ~/scratch/apps/addprograms/raxml-ng/build/bin/raxml-ng-mpi --threads auto{8} \
                                                            --rfdist \
                                                            --tree $i \
                                                            --prefix RF_$i
done

