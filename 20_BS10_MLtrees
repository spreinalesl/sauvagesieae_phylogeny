#!/bin/bash

#SBATCH --job-name=BSt
#SBATCH --partition=medium
#SBATCH --array=0-1221%20
#SBATCH --cpus-per-task=1
#SBATCH --mem=10MB
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## This command aims to collapse branches with BS below 10% from ML bootstraped gene trees, to improve ASTRAL accuracy.
## These trees were estimated by RaxMl-ng using the TBE bootstrap method.
## Option o means splice out the node (i.e. collapse branch). Applied on unsupported nodes (lesser than or equal to 10% BS)
## Tutorial: https://gensoft.pasteur.fr/docs/newick-utils/1.6/nwutils_tutorial.pdf

###########
# COMMANDS
###########

## Define names
mtype=exons

## Input trees
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/all_$mtype/raxml

## Output folder
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/all_$mtype/BS10_MLtrees
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/all_$mtype/BS10_MLtrees

## Go to the alignments folder
cd $fpath

## Define variable to list all gene trees and iterate over each element using the SLURM_ARRAY_TASK_ID variable
gene_list=($(ls * | grep XXXX)) ##########################################################################################
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})

## Collapsing trees
~/scratch/apps/conda/bin/nw_ed $gene.raxml.supportTBE 'i & b<=0.1' o > $rpath/"$gene"_BS10.tre

echo Gene tree $gene was edited using nw_ed
