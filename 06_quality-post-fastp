#!/bin/bash

#SBATCH --job-name=ochn_fastp-post
#SBATCH --partition=short
#SBATCH --cpus-per-task=8
#SBATCH --mem=4G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########

# Using 8 threads took 36 min and 2.56G to process 192 files.
# For each input FASTQ file, FastQC create a .zip file and a .html file, so, it's necessary to create an output directory
# Use -o option to redirect otput files
# -p stops a message from appearing if the directory already exists
# -t specifies the number of files which can be processed simultaneously. One file is processed per thread. Each thread will be allocated ca. 250MB of memory

###########
# COMMANDS
###########

mkdir -p ../sauvagesieae/quality-post-fastp

## fastQC
mkdir -p ../sauvagesieae/quality-post-fastp/fastqc

fastqc ../sauvagesieae/fastp/pass_unmerg/*.fastq.gz -t 8 -o ../sauvagesieae/quality-post-fastp/fastqc > ../sauvagesieae/quality-post-fastp/fastqc/fastqc-fastp.outerr 2>&1

## multiQC
multiqc ../sauvagesieae/quality-post-fastp/fastqc/*fastqc.zip -o ../sauvagesieae/quality-post-fastp > ../sauvagesieae/quality-post-fastp/multiqc-fastp.outerr 2>&1
