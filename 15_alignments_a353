#!/bin/bash

#SBATCH --job-name=mafft
#SBATCH --partition=short
#SBATCH --array=0-6
#SBATCH --cpus-per-task=4
#SBATCH --mem=12G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## 0-324%10
## Align DNA sequences for each locus using the algorith E-INS-i inplemented in mafft. This algorithm is suitable to align multiple cDNAs
## and multiple genomic sequences of a gene from closely related species, which has several conserved motifs embedded in long unalignable regions.
## As E-INS-i has the minimum assumption of the three methods, this is recommended if the nature of sequences to be aligned is not clear.
## Most genes run well with 8 to 12 G of memory. Nevetheless, genes with few samples and large amount of missing data are difficult to  align
## Consequentlyl, they need more memory. For gene 6717 60 G of memory was enought. For 4527, 5421 and 5421 100G were necessary.
## 5599 failed after all attempts, due to it has just 5 tips, it was removed from the analysis.
## For supercontig the following files were remove befor alignment because they have 0 or just 2 sequences:4806, 5656,5958, 6449, 6514, 6893, 7024, 7325, 7371, 7583,
## 5599, 6886, 6717, 5347, 6401, 5260, 4744, 6430, 6955

###########
# COMMANDS
###########

## Activate conda environment (because mafft was installed as part of hybpiper)
source /home/sreinale/.bashrc
source activate hybpiper

## Define names
probe=a353
imtype=supercontig

## Define fasta file path
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/hybpiper/fasta_files/$probe/$imtype

## Output path
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/$imtype
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/$imtype

## Go to input-files folder
cd $fpath

## Define variable to list fasta files and iterate over each element using the SLURM_ARRAY_TASK_ID variable
## Path to a list of selected genes
gene_list=($(ls * | grep fasta$))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})
gnm=$(echo $gene | sed 's/\.supercontig\.fasta//')

## Run mafft
mafft --thread ${SLURM_CPUS_PER_TASK} --genafpair --adjustdirectionaccurately --maxiterate 1000 $gene > $rpath/"$gnm"_align.fas

echo MAFFT finished for gene $gene
