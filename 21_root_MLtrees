#!/bin/bash

#SBATCH --job-name=rooting
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=10MB
#SBATCH --mail-user=xxx@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## This command runs the script Root_trees_general_pxrr_v4.R script which extracts the
## outgroup for each gene tree and write the command line
## to run newick utilities rooting
## Tutorial: https://gensoft.pasteur.fr/docs/newick-utils/1.6/nwutils_tutorial.pdf

###########
# COMMANDS
###########

## Define names
mtype=exons
program=iqtree

## Input trees
fpath=~/projects/trees/all_$mtype/$program

## Activate conda environment
source ~/.bashrc
source activate renv

## Run r script to generate the list of outgroups for each gene tree
Rscript --vanilla Root_trees_general_pxrr_v4.R

echo Root_trees_general_pxrr_v4.R script finished!

## Iterate the output file containing the commands to reroot trees
/usr/bin/bash $fpath/pxrr_commands

echo Done!
