#!/bin/bash

#SBATCH --job-name=hybphaser1
#SBATCH --partition=short
#SBATCH --array=0-95%10
#SBATCH --cpus-per-task=1
#SBATCH --mem=150MB
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## Run bash script 1_generate_consensus_sequences.sh to create consensus sequences and analyse heterozygous sites across hybpiper assambles.
## HybPhaser maps for each gene the mapped reads to the denovo contig (generated by hybpiper) and generates a consensus sequence that contains ambiguity
## codes where divergent reads occur.
## Consensus sequences summarize the information of assembled sequence reads and can contain ambiguity characters where reads differ.
## Differences in sequence reads can occur through divergent alleles, paralogous genes, sequencing errors, or contamination. The generation of consensus sequences
## allows to measure and assess the occurrence of heterozygous sites across the dataset and to identify hybrid taxa as well as paralogous genes.
## To prevent sequencing errors to be coded as ambiguity codes, variants are only called when there is a coverage of at least 10, a variant occurring at least 4 times 
## and in at least 15% of the reads.
## -c clean-up: If set, reads and mapping files are removed (.bam, .vcf.gz)
## In mean the script requires 60 MB per sample but some samples require 85MB, 98MB, so run it with 120MB. Each sample is processed in ca. 15min using a single core mode.
## Multithread seems to have a weird behaviour.

###########
# COMMANDS
###########

## Activate conda environment
source activate hybphaser

## Export path for binaries (e.g. bwa, samtools and bcftools)
export PATH=/home/sreinale/scratch/apps/conda/envs/hybphaser/bin:$PATH

## Define names
probe=a353
mtype=sauv_sprl

## Define fasta file path
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/hybpiper/$mtype/$probe

## Path to sample list
namelist=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/name_list/namelist_hybphaser_test.txt
sample_list=($(cat $namelist))
sampnm=(${sample_list[$SLURM_ARRAY_TASK_ID]})
echo $sampnm

## Output path
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/hybphaser/$probe
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/hybphaser/$probe

## Temporary folder
cd $TMPDIR

## As all sample runs have to be in the same directory, extract assembly directories
## to the temporary directory
echo begin extraction!
tar -xzf $fpath/assembly_results.tar.gz $sampnm
echo end extraction!

## Run 1_generate_consensus_sequences.sh script
#bash ~/scratch/apps/conda/envs/hybphaser/HybPhaser/1_generate_consensus_sequences.sh -n $namelist -o $rpath -c -t ${SLURM_CPUS_PER_TASK} ## using a sample list
bash ~/scratch/apps/conda/envs/hybphaser/HybPhaser/1_generate_consensus_sequences.sh -s $sampnm -o $rpath -c -t ${SLURM_CPUS_PER_TASK} ## using an array to process one sample per job

echo HybPhaser 1 end!
