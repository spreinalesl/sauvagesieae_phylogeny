#!/bin/bash

#SBATCH --job-name=raxml_opt
#SBATCH --partition=medium
#SBATCH --array=0-609%20
#SBATCH --cpus-per-task=1
#SBATCH --mem=1G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## These commands extract memory usage and number os threads nedeed to run raxml on each locus, from the raxml --parse output

###########
# COMMANDS
###########

## Define variable to list all files and iterate over each element using the SLURM_ARRAY_TASK_ID variable
## Path to a list of selected genes (all schn plus a353 genes with more than 25% of taxa represented)
glistpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/hybpiper/get_seqs_summ/selected_genes.txt
gene_list=($(cat $glistpath))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})

## Extract inf from the raxml parse output

cd ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/raxml

grep Estimated T1_$gene.raxml.log >> memory_req.txt

grep Recommended T1_$gene.raxml.log >> threads_num.txt
