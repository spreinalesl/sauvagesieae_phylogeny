Begin MrBayes;
[Script documentation carried out using comments]

[Create a log file for the analysis]
log start filename = file_name.log;

[Read the matrix in NEXUS format]
execute file_name.nex;

[Close analysis at end]
set autoclose = Yes;

[Show the status of all taxa, according to the documentation]
taxastat;

[Set up a particular model for each partition]
Set partition = concatenate;
lset applyto = (1,4,8,9,12) nst = 6 rates = gamma; [GTR+G]

[Unlink parameters across partitions]
unlink shape = (all) pinvar = (all) statefreq = (all) revmat = (all) tratio = (all);

[Allow separate gamma parameters for each partition]
prset applyto = (all) ratepr = variable;

[Show the model just specified for each partition]
showmodel;

[Set up the MCMC parameters. Start each chain from a slightly perturbed version of the good tree with nperts]
mcmcp nruns = 4 ngen = 10000000 nchains = 8 samplefreq = 10000 printfreq = 1000 mcmcdiagn = yes diagnfreq = 1000 nperts=3;

[Run the MCMC lowering the temperature. Default temp=0.1]
mcmc;

[Summarize the posterior trees]
sumt nruns = 4 relburnin = Yes burninfrac = 0.5 contype=Allcompat;
plot;

[Summarize parameter posteriors]
sump;

log stop;
end;
