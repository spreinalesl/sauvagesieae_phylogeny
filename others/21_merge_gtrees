#!/bin/bash

#SBATCH --job-name=merge_gtrees
#SBATCH --partition=short
#SBATCH --cpus-per-task=1
#SBATCH --mem=100MB
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## This script merges individual trees in a single file

###########
# COMMANDS
###########

## Matrix path name
mtype=all_exons
program=iqtree_plus_models

## Input trees
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/$mtype/$program

## Path to sample list
genelist=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/name_list/genes_put_orth.txt
glist=$(cat $genelist)

## Go to temp directory
cd $TMPDIR
tar -xzvf $fpath/treefile.tar.gz $glist

## Test
#cd $fpath
echo "files to merge:"
ls * | grep treefile | wc -l

## Merge all gene trees in a single file
cat *.treefile > sauv_"$mtype"_gtrees.tre
echo trees were merged!

## Fix a %$#$@#% problem caused by the MAFFT function --accurateX
sed -i -e 's/_R_//g' sauv_"$mtype"_gtrees.tre
echo MAFFT problem fixed!

mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/put_orth
mv sauv_"$mtype"_gtrees.tre ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/put_orth
