## Activate conda environment
source /home/sreinale/.bashrc
source activate hybpiper

## Define paths
rpath=~/scratch/private/sauvagesieae/hybpiper/sauv_sprl/a353/

# namelist
npath=~/scratch/private/sauvagesieae/namelist_sprl.txt

## Define target file
