#!/bin/bash

#SBATCH --job-name=raxml_check
#SBATCH --partition=medium
#SBATCH --array=0-609%20
#SBATCH --cpus-per-task=1
#SBATCH --mem=1G
#SBATCH --mail-user=s.reinales@kew.org
#SBATCH --mail-type=END,FAIL

###########
# NOTES
###########
## First set of lines checks if the matrix can actually be read and doesn't contain sites with only undetermined characters, sequences with undetermined characters or duplicate taxon names
## Using the optiion --printidenticalsequences raxml will generate a .reduced alignment with all undetermined columns removed, but without removing exactly identical sequences.
## Second, run RAxML-NG in parser mode to generate a binary MSA file (ali.fa.raxml.rba), which can be loaded by RAxML-NG much faster than the original FASTA alignment.
## Furthermore, it will print estimated memory requirements and the recommended number of threads for the dataset.
## T0.raxml.reduced.phy is the reduced matrix generated by RaxML after removing duplicates (not in this case) and undeterminate sites.
## T0.raxml.reduced.phy.raxml.rba is a compressed matrix generated by RaxML to increase the eficiency when the matrix is read
## According to RaxML this process should be ran using 8 threads and 1154 MB

###########
# COMMANDS
###########

## Input fasta files
fpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/alignments/taper

## Output path
mkdir -p ~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/raxml
rpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/raxml

## Go to the alignments folder
cd $fpath

## Define variable to list all alignment and iterate over each element using the SLURM_ARRAY_TASK_ID variable
## Path to a list of selected genes (all schn plus a353 genes with more than 25% of taxa represented)
glistpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/hybpiper/get_seqs_summ/selected_genes.txt
gene_list=($(cat $glistpath))
gene=(${gene_list[$SLURM_ARRAY_TASK_ID]})

## Get info about best-fit substitution model previously obtained using Iqtree
bmpath=~/projects/rbgk/users_area/sreinales/results/sauvagesieae/trees/subs_model/best_fit_models_summ.txt
model=$(cat $bmpath | grep $gene | cut -d ':' -f 3)

## Check matrix
~/scratch/apps/addprograms/raxml-ng/build/bin/raxml-ng-mpi --check \
                                                           --msa $gene*.fasta \
                                                           --model $model \
                                                           --prefix $rpath/T0_"$gene"

## Parser mode
~/scratch/apps/addprograms/raxml-ng/build/bin/raxml-ng-mpi --parse \
                                                           --msa $rpath/T0_"$gene"*.reduced.phy \
                                                           --model $model \
                                                           --prefix $rpath/T1_"$gene"

echo RaxML_check finished for gene $gene
